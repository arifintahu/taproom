{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npx --yes pnpm@9.15.9 install --frozen-lockfile",
  "buildCommand": "cd web && VITE_DEFAULT_CHAIN=onyx npx --yes pnpm@9.15.9 build",
  "outputDirectory": "web/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- web vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
